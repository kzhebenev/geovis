FROM python:3.12-slim
WORKDIR /srv
RUN pip install --no-cache-dir "fastapi==0.142.2" "uvicorn[standard]==0.54.0" "pydantic==2.13.5" "numpy==2.5.3" "mcp==2.3.0" "httpx==0.28.1"
COPY app ./app
RUN useradd -u 1000 -m geovis && mkdir -p /data && chown geovis /data
USER geovis
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/api/v1/health', timeout=4)"
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers", "--forwarded-allow-ips", "*"]
