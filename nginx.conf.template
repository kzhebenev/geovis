# превью ссылок в мессенджерах: og:image = снимок той же карты. В HTML попадают только безопасные символы
# запроса (иначе — превью по умолчанию): кавычки и < > из строки запроса не вставляются никогда.
map $request_uri $og_args {
  # $args после try_files → /index.html пуст — берём запрос из исходного URI
  "~^[^?]*\?(?<q>[A-Za-z0-9_.,=&%+-]*)$" $q;
  default "";
}

server {
  listen 80;
  root /usr/share/nginx/html;

  gzip on;
  gzip_comp_level 6;
  gzip_min_length 1024;
  gzip_types application/octet-stream application/json application/geo+json application/javascript text/css image/svg+xml;

  # данные: только реальные файлы, иначе 404 (не отдавать index.html вместо данных)
  # типы только для каталога данных: types{} на уровне server затёр бы стандартные (text/html и др.)
  location /data/ {
    types { application/octet-stream bin; application/json json; application/geo+json geojson; }
    try_files $uri =404;
    add_header Cache-Control "public, max-age=3600";
  }
  location /assets/ {
    try_files $uri =404;
    add_header Cache-Control "public, max-age=31536000, immutable";
  }
  location / {
    try_files $uri /index.html;
    add_header Cache-Control "no-cache";
  }
  location = /index.html {
    add_header Cache-Control "no-cache";
    sub_filter_once on;
    sub_filter '<!--OG-->' '<meta property="og:type" content="website"><meta property="og:site_name" content="GeoVis"><meta property="og:title" content="GeoVis — 3D-карта данных"><meta property="og:description" content="Население, ВВП, климат, регионы — 3D на глобусе и карте"><meta property="og:image" content="https://$host/api/v1/preview.png?$og_args"><meta property="og:image:width" content="1200"><meta property="og:image:height" content="630"><meta name="twitter:card" content="summary_large_image">';
  }
  # API и MCP — в контейнер api (FastAPI)
  location /api/ {
    proxy_pass ${GEOVIS_API_UPSTREAM};
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    client_max_body_size 50m;
    proxy_read_timeout 120s;
  }
  location /mcp {
    proxy_pass ${GEOVIS_API_UPSTREAM};
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_buffering off;
    proxy_read_timeout 300s;
    client_max_body_size 50m;
  }

  location = /healthz { access_log off; return 200 "ok\n"; }
}
