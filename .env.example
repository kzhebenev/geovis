# GeoVis — пример настроек сервера / server settings example. Скопируйте в .env / copy to .env
# Ключ администратора API (выдаёт ключи проектам). Сгенерируйте: openssl rand -hex 24
# Admin API key (issues project keys). Generate: openssl rand -hex 24
GEOVIS_ADMIN_KEY=change-me

# Где слушает nginx на хосте (наружу — через ваш reverse proxy с TLS)
# Host address/port nginx binds to (expose via your TLS reverse proxy)
GEOVIS_BIND=127.0.0.1
GEOVIS_PORT=8105

# Публичный адрес сайта — для ссылок, iframe, превью и MCP / public site URL for links, iframes, previews, MCP
GEOVIS_PUBLIC_URL=http://localhost:8105

# Необязательно / optional
# GEOVIS_MAX_DATASETS_PER_KEY=500
